{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "OpsHub: prepare Flutter toolchain",
      "type": "shell",
      "command": "node",
      "args": [
        "scripts/toolchain-doctor.mjs",
        "--profile",
        "flutter"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
