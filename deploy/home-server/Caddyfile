{
  # Cloudflare Tunnel reaches this loopback-only origin from a private/local
  # address. Trust that hop, read the client IP from Cloudflare's protected
  # header, then normalize what downstream services receive.
  servers {
    trusted_proxies static private_ranges
    trusted_proxies_strict
    client_ip_headers CF-Connecting-IP
  }
}

# The new web hostname serves only the environment's public web surface. API
# and realtime traffic have their own exact hostname below.
http://{$OPSHUB_DOMAIN} {
  encode gzip zstd

  log {
    output discard
  }

  @insecure_edge_request header X-Forwarded-Proto http
  redir @insecure_edge_request https://{host}{uri} 308

  header {
    -Server
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    X-Frame-Options "SAMEORIGIN"
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Permissions-Policy "camera=(self), clipboard-read=(self), clipboard-write=(self), fullscreen=(self), geolocation=(), microphone=(), payment=(), usb=()"
    Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; worker-src 'self' blob:; child-src 'self' blob:; manifest-src 'self'; media-src 'self' data: blob:"
  }

  # A new web origin must not accidentally become a legacy API or realtime
  # origin. Keep these paths fail-closed instead of serving the SPA fallback.
  @new_web_api path /api /api/*
  handle @new_web_api {
    respond "Not found" 404
  }
  handle /ws* {
    respond "Not found" 404
  }

  handle /reset-password* {
    reverse_proxy {
      dynamic a api 3000 {
        refresh 5s
        versions ipv4
      }
      lb_policy round_robin
      header_up X-Forwarded-For {client_ip}
      header_up X-Real-IP {client_ip}
    }
  }

  handle /download/ {
    # Rewrite preserves the original query string; redir then emits the
    # normalized path without inventing a trailing '?' when no query exists.
    route {
      rewrite * /download
      redir * {uri} 308
    }
  }

  handle /download {
    root * /srv/downloads
    rewrite * /download.html
    file_server
  }

  handle /help/ {
    route {
      rewrite * /help
      redir * {uri} 308
    }
  }

  # Keep the exact Help entrypoint on the SPA host. The direct-origin release
  # gate probes /help without a trailing slash; make that contract explicit
  # instead of relying on the catch-all SPA fallback during a static swap.
  handle /help {
    root * /srv/web
    rewrite * /index.html
    file_server
  }

  handle_path /help/assets/* {
    root * /srv/downloads/help/assets
    file_server
  }

  # Keep the staff-facing Seatalk invite URL short and changeable without
  # shipping a new client when the invite token is rotated.
  redir /seatalk-support* https://link.seatalk.io/group/open?invite_id=IkaYSKrlQkImmkCfNj4aBdpd5cpcCWFPaaegCUhYXjgcfi1Tzn9E9Gbuac_qt8Jk5mruc0AJGqQLaQeSWG1e 302

  header /help Cache-Control "no-store, no-cache, must-revalidate"

  @staging_download path /staging-download /staging-download/ /staging-download/*
  handle @staging_download {
    route {
      rewrite * /download
      redir * https://staging.phongvu.work{uri} 302
    }
  }

  handle_path /uploads/* {
    root * /srv/uploads
    file_server
  }

  header /downloads/latest.json Cache-Control "no-store, no-cache, must-revalidate"

  handle_path /downloads/* {
    root * /srv/downloads
    file_server
  }

  handle /health {
    respond "ok" 200
  }

  header /flutter_service_worker.js Cache-Control "no-store, no-cache, must-revalidate"
  header /version.json Cache-Control "no-store, no-cache, must-revalidate"
  header / Cache-Control "no-store, no-cache, must-revalidate"
  header /index.html Cache-Control "no-store, no-cache, must-revalidate"
  header /main.dart.js Cache-Control "no-store, no-cache, must-revalidate"
  header /flutter_bootstrap.js Cache-Control "no-store, no-cache, must-revalidate"
  header /flutter.js Cache-Control "no-store, no-cache, must-revalidate"
  header /manifest.json Cache-Control "no-store, no-cache, must-revalidate"

  handle {
    root * /srv/web
    try_files {path} /index.html
    file_server
  }
}

# The API hostname is an exact namespace. Only /v1/* is accepted; BIDV and
# realtime are explicitly routed before the general NestJS proxy.
http://{$OPSHUB_API_DOMAIN} {
  encode gzip zstd
  log {
    output discard
  }

  log staging_home_load_telemetry {
    no_hostname
    output file /data/staging-home-load-telemetry.log {
      mode 0600
      roll_size 10MiB
      roll_keep 2
      roll_keep_for 24h
    }
    format filter {
      request delete
      resp_headers delete
      tls delete
      user_id delete
      telemetry_nonce_hash hash
      wrap json
    }
  }

  @staging_home_load_request {
    host {$OPSHUB_API_DOMAIN}
    method GET
    path /v1/home/summary
    header X-OpsHub-Load-Test *
    header_regexp telemetry_nonce X-OpsHub-Telemetry-Nonce ^[a-f0-9]{64}$
    header_regexp load_range X-OpsHub-Load-Range ^home_(1|7|30|90)d$
    header_regexp load_variant X-OpsHub-Load-Variant ^(legacy|daily_series)$
  }
  request_header @staging_home_load_request X-Request-Id {http.request.uuid}
  log_name @staging_home_load_request staging_home_load_telemetry
  log_append @staging_home_load_request request_id {http.request.uuid}
  log_append @staging_home_load_request reverse_proxy_duration_ms {rp.duration_ms}
  log_append @staging_home_load_request upstream_attempt_duration_ms {rp.upstream.duration_ms}
  log_append @staging_home_load_request reverse_proxy_retries {rp.retries}
  log_append @staging_home_load_request telemetry_nonce_hash {http.request.header.X-OpsHub-Telemetry-Nonce}
  log_append @staging_home_load_request load_range {http.request.header.X-OpsHub-Load-Range}
  log_append @staging_home_load_request load_variant {http.request.header.X-OpsHub-Load-Variant}

  @insecure_edge_request header X-Forwarded-Proto http
  redir @insecure_edge_request https://{host}{uri} 308

  header {
    -Server
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    X-Frame-Options "DENY"
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Cache-Control "no-store"
  }

  @bidv_token path /v1/bidv/oauth2/token
  handle @bidv_token {
    rewrite * /oauth2/token
    reverse_proxy {
      dynamic a api 3000 {
        refresh 5s
        versions ipv4
      }
      lb_policy round_robin
      header_up X-Forwarded-For {client_ip}
      header_up X-Real-IP {client_ip}
    }
  }

  @bidv_balance path /v1/bidv/balance-changes
  handle @bidv_balance {
    rewrite * /v1/balance-changes
    reverse_proxy {
      dynamic a api 3000 {
        refresh 5s
        versions ipv4
      }
      lb_policy round_robin
      header_up X-Forwarded-For {client_ip}
      header_up X-Real-IP {client_ip}
    }
  }

  @bidv_unknown path /v1/bidv /v1/bidv/*
  handle @bidv_unknown {
    respond "Not found" 404
  }

  @realtime path /v1/ws /v1/ws*
  handle @realtime {
    uri strip_prefix /v1
    reverse_proxy realtime:8080 {
      header_up X-Forwarded-For {client_ip}
      header_up X-Real-IP {client_ip}
    }
  }

  handle_path /v1/* {
    reverse_proxy {
      dynamic a api 3000 {
        refresh 5s
        versions ipv4
      }
      lb_policy round_robin
      header_up X-Forwarded-For {client_ip}
      header_up X-Real-IP {client_ip}
    }
  }

  handle {
    respond "Not found" 404
  }
}

# Legacy web host bridge. UI routes redirect to the new web host while the
# machine paths required by installed clients remain transparent during the
# measured 24-hour zero-valid-traffic bridge window.
http://{$OPSHUB_LEGACY_DOMAIN} {
  encode gzip zstd

  log {
    output discard
  }

  log legacy_uploads {
    no_hostname
    output file /data/legacy-uploads-access.log {
      mode 0600
      roll_size 10MiB
      roll_keep 14
      roll_keep_for 336h
    }
    format filter {
      request>uri delete
      request>remote_ip delete
      request>client_ip delete
      request>remote_port delete
      request>headers delete
      request>host delete
      request>proto delete
      resp_headers delete
      user_id delete
      legacy_path hash
      wrap json
    }
  }

  @legacy_upload_request path /uploads/*
  log_name @legacy_upload_request legacy_uploads
  log_append @legacy_upload_request legacy_path {http.request.uri.path}

  @insecure_edge_request header X-Forwarded-Proto http
  redir @insecure_edge_request https://{host}{uri} 308

  header {
    -Server
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    X-Frame-Options "SAMEORIGIN"
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Cache-Control "no-store"
  }

  # Legacy app clients still call /api and /ws. The old API staging tunnel
  # overrides Host to this site, so it is covered without a cross-environment
  # catch-all.
  @legacy_api path /api /api/*
  handle @legacy_api {
    # Preserve the existing legacy contract: NestJS receives the route without
    # the public /api compatibility prefix.
    uri strip_prefix /api
    reverse_proxy {
      dynamic a api 3000 {
        refresh 5s
        versions ipv4
      }
      lb_policy round_robin
      header_up X-Forwarded-For {client_ip}
      header_up X-Real-IP {client_ip}
    }
  }

  handle /ws* {
    reverse_proxy realtime:8080 {
      header_up X-Forwarded-For {client_ip}
      header_up X-Real-IP {client_ip}
    }
  }

  handle /reset-password* {
    reverse_proxy {
      dynamic a api 3000 {
        refresh 5s
        versions ipv4
      }
      lb_policy round_robin
      header_up X-Forwarded-For {client_ip}
      header_up X-Real-IP {client_ip}
    }
  }

  @legacy_download path /download /download/
  handle @legacy_download {
    route {
      rewrite * /download
      redir * https://{$OPSHUB_DOMAIN}{uri} 308
    }
  }

  handle_path /help/assets/* {
    root * /srv/downloads/help/assets
    file_server
  }

  @legacy_help path /help /help/
  handle @legacy_help {
    route {
      rewrite * /help
      redir * https://{$OPSHUB_DOMAIN}{uri} 308
    }
  }

  handle_path /uploads/* {
    root * /srv/uploads
    file_server
  }

  handle_path /downloads/* {
    root * /srv/downloads
    file_server
  }

  handle /health {
    respond "ok" 200
  }

  @legacy_staging_download path /staging-download /staging-download/ /staging-download/*
  handle @legacy_staging_download {
    route {
      rewrite * /download
      redir * https://staging.phongvu.work{uri} 308
    }
  }

  handle {
    redir https://{$OPSHUB_DOMAIN}{uri} 308
  }
}
