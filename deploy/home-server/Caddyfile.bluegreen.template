# Opt-in OPS-78 edge-selection fixture. This template is rendered by
# blue-green-topology.mjs and is not mounted by the default Caddy service.
# A later traffic-switch slice must validate, atomically reload and drain the
# selected upstreams; this slice only renders and fingerprints the candidate.

http://{$OPSHUB_API_DOMAIN} {
  encode gzip zstd

  @bidv_token path /v1/bidv/oauth2/token
  handle @bidv_token {
    rewrite * /oauth2/token
    reverse_proxy {{API_UPSTREAM}} {
      header_up X-Forwarded-For {client_ip}
      header_up X-Real-IP {client_ip}
    }
  }

  @bidv_balance path /v1/bidv/balance-changes
  handle @bidv_balance {
    rewrite * /v1/balance-changes
    reverse_proxy {{API_UPSTREAM}} {
      header_up X-Forwarded-For {client_ip}
      header_up X-Real-IP {client_ip}
    }
  }

  @bidv_unknown path /v1/bidv /v1/bidv/*
  handle @bidv_unknown {
    respond "Not found" 404
  }

  @realtime path /v1/ws /v1/ws*
  handle @realtime {
    uri strip_prefix /v1
    reverse_proxy {{WS_UPSTREAM}} {
      header_up X-Forwarded-For {client_ip}
      header_up X-Real-IP {client_ip}
    }
  }

  handle_path /v1/* {
    reverse_proxy {{API_UPSTREAM}} {
      header_up X-Forwarded-For {client_ip}
      header_up X-Real-IP {client_ip}
    }
  }

  handle /v1/health {
    respond "ok" 200
  }

  handle {
    respond "blue-green fixture" 404
  }
}
