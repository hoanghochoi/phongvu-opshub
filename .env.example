# Local Docker infrastructure only. Copy this file to .env and replace both
# placeholders. Never reuse production or staging credentials here.
OPSHUB_LOCAL_POSTGRES_PASSWORD=replace-with-long-random-local-db-password
OPSHUB_LOCAL_REDIS_PASSWORD=replace-with-long-random-local-redis-password

# Local compose does not enable BIDV H2H.
BIDV_H2H_INGEST_ENABLED=false
BIDV_H2H_PROJECTION_ENABLED=false
